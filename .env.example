# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Secret key (sb_secret_...) or legacy service_role key.
# Used for order placement, payment confirmation and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (no trailing slash). Used for auth redirects, sitemap, SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (Dashboard → Account & Settings → API Keys). Start with TEST keys (rzp_test_...). ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: secret you set for https://<site>/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Scheduled maintenance (expires unpaid orders, refreshes popularity) ---
# Long random string; the scheduler must send "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Random string used to anonymise product-view counting (no IPs are stored)
VIEW_HASH_SALT=

# --- Email notifications (optional; Resend-compatible API). Leave empty to disable. ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- Shipping: "manual" (staff enter tracking) or "shiprocket" (see docs/SHIPPING.md) ---
SHIPPING_PROVIDER=manual
# Shiprocket API user (Shiprocket → Settings → API → Create an API user). SERVER ONLY.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact pickup location nickname from Shiprocket → Settings → Pickup addresses, and its PIN code
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Long random string; set the same token on the Shiprocket webhook for https://<site>/api/shipping/webhook
SHIPROCKET_WEBHOOK_TOKEN=
